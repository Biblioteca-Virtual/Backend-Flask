# Copiá este archivo como .env y completá los valores. El .env no se sube a git.

SECRET_KEY=cambiar-en-produccion-clave-de-32-caracteres-minimo
FRONTEND_URL=http://localhost:4200
# Minutos que dura el link de "Verificar Sesión"
SESSION_VERIFICATION_MINUTES=15

# Correo de verificación (Gmail)
# 1. Activá la verificación en dos pasos en la cuenta de Google.
# 2. Creá una contraseña de aplicación en https://myaccount.google.com/apppasswords
# 3. Pegala abajo (son 16 letras; los espacios se pueden dejar o sacar).
# Si MAIL_USERNAME queda vacío, el link de verificación se muestra en la consola de Flask.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=ÁmbarLy
